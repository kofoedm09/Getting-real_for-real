<Window x:Class="Getting_real.CreateCostumer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Getting_real"
        mc:Ignorable="d"
        Title="CreateCostumer" Height="400" Width="400">
    <Grid>
        <TextBox x:Name="txtb_FirstName" HorizontalAlignment="Left" Margin="240,107,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" RenderTransformOrigin="0.55,0.592"/>
        <TextBox x:Name="txtb_Nr" HorizontalAlignment="Left" Margin="240,203,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <Label x:Name="lbl_FirstName" Content="Indtast dit fornavn" HorizontalAlignment="Left" Margin="35,103,0,0" VerticalAlignment="Top"/>
        <Label x:Name="lbl_nr" Content="Indtast dit telefonnummer" HorizontalAlignment="Left" Margin="35,199,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.063,-0.307"/>
        <Image x:Name="Logo" HorizontalAlignment="Left" Height="83" Margin="35,10,0,0" VerticalAlignment="Top" Width="86" Source="/Billede Vekto.png"/>
        <Label x:Name="lbl_kunde" Content="Kunde information" HorizontalAlignment="Left" Margin="174,34,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.126,-0.322" Height="34" Width="159"/>
        <Label x:Name="lbl_LastName" Content="Indtast dit efternavn" HorizontalAlignment="Left" Margin="35,151,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.494,0.171"/>
        <TextBox x:Name="txtb_LastName" HorizontalAlignment="Left" Margin="240,155,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <Button x:Name="bt_add" Content="Tilføj" HorizontalAlignment="Left" Margin="309,294,0,0" VerticalAlignment="Top" Width="41"/>
        <Button x:Name="bt_Delete_" Content="Slet" HorizontalAlignment="Left" Margin="254,294,0,0" VerticalAlignment="Top"/>

    </Grid>
</Window>
