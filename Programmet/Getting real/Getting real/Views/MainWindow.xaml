<Window x:Class="Getting_real.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vekto - Værkstedsstyring" 
        Height="750" Width="1250"
        Background="#F3F4F6"
        FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Genbrugelig stil til kort (Cards) -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Primær gul/amber knap -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F5B82E"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E5A922"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Topbar -->
            <RowDefinition Height="70"/>
            <!-- Hovedindhold -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== TOPBAR ==================== -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="24,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Udskift evt. Source med stien til dit Vekto-logo -->
                    <Image Source="/Images/LOGO.JPG" Width="100" Height="60" Stretch="Uniform" VerticalAlignment="center"/>
                    <!--<Image Source=""/>-->
                    <TextBlock Text="BICYCLE WORKSHOP" FontSize="11" FontWeight="Bold" Foreground="#6B7280" VerticalAlignment="Center" Margin="10,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== HOVEDINDHOLD (2 KOLONNER) ==================== -->
        <Grid Grid.Row="1" Margin="24">
            <Grid.ColumnDefinitions>
                <!-- Venstre: Kundekartotek -->
                <ColumnDefinition Width="49.059"/>
                <ColumnDefinition Width="290.941"/>
                <ColumnDefinition Width="24"/>
                <!-- Højre: Dashboard & Kundedetaljer -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- VENSTRE KOLONNE: KUNDER -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Height="616" VerticalAlignment="Center" Grid.ColumnSpan="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Overskrift + tæller -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock Text="Kunder" FontSize="20" FontWeight="Bold" Foreground="#111827" VerticalAlignment="Center"/>
                        <Border Background="#E5E7EB" CornerRadius="10" Padding="10,4" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding Customers.Count, StringFormat={}{0} kunder}" FontSize="12" FontWeight="SemiBold" Foreground="#374151"/>
                        </Border>
                    </DockPanel>

                    <!-- Søgefelt -->
                    <Border Grid.Row="1" Background="#F9FAFB" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,12">
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                 BorderThickness="0" Background="Transparent" FontSize="14" Foreground="#111827"
                                 ToolTip="Søg efter navn eller telefonnummer"/>
                    </Border>

                    <!-- Eneste "+ Ny kunde" knap -->
                    <Button Grid.Row="2" Content="+ Ny kunde" Style="{StaticResource PrimaryButtonStyle}" 
                            Command="{Binding OpenNewCustomerCommand}" Margin="0,0,0,16"/>

                    <!-- Kundeliste -->
                    <ListBox Grid.Row="3" ItemsSource="{Binding FilteredCustomers}" SelectedItem="{Binding SelectedCustomer}"
                             BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,10" BorderBrush="#F3F4F6" BorderThickness="0,0,0,1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="#111827"/>
                                        <TextBlock Text="{Binding Phone}" FontSize="13" Foreground="#6B7280" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- HØJRE KOLONNE -->
            <Grid Grid.Column="3">
                <Grid.RowDefinitions>
                    <!-- KPI Overblikskort -->
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <!-- Dynamisk indhold (Empty State vs. Valgt Kunde) -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 3 STATUS-KORT (KPI'ER) -->
                <UniformGrid Grid.Row="0" Columns="3">
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="I gang" FontSize="14" Foreground="#6B7280" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding InProgressCount}" FontSize="32" FontWeight="Bold" Foreground="#111827" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="5,0,5,0">
                        <StackPanel>
                            <TextBlock Text="Afventer dele" FontSize="14" Foreground="#6B7280" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding WaitingPartsCount}" FontSize="32" FontWeight="Bold" Foreground="#111827" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="10,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Klar til afhentning" FontSize="14" Foreground="#6B7280" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ReadyForPickupCount}" FontSize="32" FontWeight="Bold" Foreground="#111827" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- TILSTAND A: INGEN KUNDE VALGT (Empty State uden ekstra knap) -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}" 
                        Visibility="{Binding IsNoCustomerSelected, Converter={StaticResource BoolToVis}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="🚲" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12" Opacity="0.5"/>
                        <TextBlock Text="Ingen kunde valgt" FontSize="20" FontWeight="Bold" Foreground="#111827" HorizontalAlignment="Center"/>
                        <TextBlock Text="Vælg en kunde i listen til venstre for at se historik og sager." 
                                   FontSize="14" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- TILSTAND B: VALGT KUNDE + SAGSOVERSIGT -->
                <Grid Grid.Row="2" Visibility="{Binding IsCustomerSelected, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Kundeprofil-kort -->
                    <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="+ Ny reparationssag" Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding CreateTicketForCustomerCommand}" VerticalAlignment="Top" Click="Button_Click_Rep"/>

                            <StackPanel>
                                <TextBlock Text="{Binding SelectedCustomer.Name}" FontSize="22" FontWeight="Bold" Foreground="#111827"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="Mobil: " FontWeight="SemiBold" Foreground="#6B7280"/>
                                    <TextBlock Text="{Binding SelectedCustomer.Phone}" Foreground="#111827" Margin="0,0,24,0"/>
                                    <TextBlock Text="Email: " FontWeight="SemiBold" Foreground="#6B7280"/>
                                    <TextBlock Text="{Binding SelectedCustomer.Email}" Foreground="#111827"/>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Kundens reparationssager -->
                    <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Tidligere og aktive reparationssager" FontSize="18" FontWeight="Bold" 
                                       Foreground="#111827" Margin="0,0,0,16"/>

                            <DataGrid Grid.Row="1" ItemsSource="{Binding SelectedCustomer.Tickets}" 
                                      SelectedItem="{Binding SelectedTicket}"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      Background="White" BorderThickness="0" GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#F3F4F6" RowHeight="42" HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Sags-ID" Binding="{Binding Id}" Width="90"/>
                                    <DataGridTextColumn Header="Cykel" Binding="{Binding BikeModel}" Width="140"/>
                                    <DataGridTextColumn Header="Problem" Binding="{Binding ProblemDescription}" Width="*"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                                    <DataGridTextColumn Header="Dato" Binding="{Binding CreatedDate, StringFormat=dd. MMM yyyy}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
